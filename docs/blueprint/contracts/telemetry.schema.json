{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/meridian/telemetry.schema.json",
  "title": "TelemetryFrameInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_event_id",
    "stream_id",
    "machine_id",
    "event_time",
    "data_mode",
    "cycle",
    "settings",
    "readings"
  ],
  "properties": {
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "stream_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "machine_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "replay",
        "synthetic",
        "live"
      ]
    },
    "cycle": {
      "type": "integer",
      "minimum": 0
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "maxItems": 10
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_id",
          "value",
          "unit"
        ],
        "properties": {
          "sensor_id": {
            "type": "string",
            "format": "uuid"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    }
  }
}
