# Proposed application configuration. This documentation pack does not load these values.
# Copy to an ignored local .env only after application bootstrap. Replace placeholders.
APP_ENV=development
DATA_MODE=replay
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/meridian
OIDC_ISSUER_URL=http://localhost:8080/realms/meridian-dev
OIDC_CLIENT_ID=meridian-web
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
SESSION_SECRET=GENERATE_LOCALLY
CSRF_SECRET=GENERATE_LOCALLY
ALLOWED_ORIGINS=http://localhost:5173
ARTIFACT_BUCKET=meridian-dev-private
ARTIFACT_ENDPOINT=http://localhost:9000
ARTIFACT_ACCESS_KEY=CHANGE_ME
ARTIFACT_SECRET_KEY=CHANGE_ME
MLFLOW_TRACKING_URI=http://localhost:5000
INFERENCE_WINDOW_CYCLES=30
FAILURE_HORIZON_CYCLES=30
LIVE_FRESHNESS_SECONDS=120
MCP_ENABLED=false
ASSISTANT_ENABLED=false
