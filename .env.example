# Copy to .env or let scripts/start-local.ps1 initialize it securely.
# Empty key is a placeholder. Startup generates one; never commit your .env.
SENTINEL_API_KEY=
SENTINEL_MODEL_DIR=runs/fd001-v1
# Trusted manifest for the supplied, unchanged FD001 bundle.
SENTINEL_BUNDLE_SHA256=06d46a9c4f5f71aeb220ade135e52e713a0bd41f362e7caf00eda743442e7cfd
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000

# Optional: blank keeps experimental inference independent of PostgreSQL.
# DATABASE_URL=postgresql+psycopg://USER:PERCENT_ENCODED_PASSWORD@127.0.0.1:55432/meridian_dev
DATABASE_URL=

# Phase 3: opt in only after migration and explicit operator bootstrap.
SENTINEL_AUTH_ENABLED=false
# true permits non-Secure cookies ONLY with loopback origins/Host.
SENTINEL_AUTH_LOCALHOST=false
# Comma-separated exact origins, no paths, credentials or wildcard.
# For local startup: http://127.0.0.1:8001 (match your actual configured port)
SENTINEL_AUTH_ORIGINS=
SENTINEL_SESSION_SECONDS=28800
SENTINEL_LOGIN_LIMIT=10
SENTINEL_LOGIN_WINDOW=300
SENTINEL_LOGIN_GLOBAL_LIMIT=100
