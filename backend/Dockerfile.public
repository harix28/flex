FROM node:22-alpine AS web
WORKDIR /web
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY sentinel/ ./sentinel/
COPY database/ ./database/
COPY alembic.ini ./
COPY --from=web /web/dist /app/web
COPY runs/fd001-v1/ /app/models/fd001-v1/
COPY runs/all-subsets-20261030-v1/COMBINED/forest.json /app/models/combined-rf/forest.json
COPY runs/all-subsets-20261030-v1/COMBINED/forest.npz /app/models/combined-rf/forest.npz
ENV SENTINEL_MODEL_DIR=/app/models/fd001-v1 \
    SENTINEL_BUNDLE_SHA256=06d46a9c4f5f71aeb220ade135e52e713a0bd41f362e7caf00eda743442e7cfd \
    SENTINEL_CLASSIFIER_DIR=/app/models/combined-rf \
    SENTINEL_HOST=0.0.0.0 SENTINEL_CONTAINER_MODE=true \
    SENTINEL_AUTH_ENABLED=true SENTINEL_AUTH_LOCALHOST=false \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1
RUN useradd -u 10001 -m sentinel && chown -R sentinel:sentinel /app
USER sentinel
EXPOSE 10000
CMD ["python", "-m", "sentinel.public_serve"]
